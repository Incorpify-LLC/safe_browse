<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Safe Browse" Manufacturer="Incorpify LLC" Version="0.1.0" UpgradeCode="C75EDBF5-E5BB-445D-A40D-E64310E9E76D" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer Safe Browse version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Safe Browse">
        <Component Id="ServiceFiles" Guid="*">
          <File Id="ServiceExe" Source="..\artifacts\service\SafeBrowse.Service.exe" KeyPath="yes" />
          <File Source="..\artifacts\service\appsettings.json" />
          <!--
            ES256 public key for verifying the signed blocklist manifest. appsettings.json
            points ManifestPublicKeyPath at this exact path, and ListArtifactStore reads it
            before installing any list. Without it on disk, list sync cannot succeed.
          -->
          <File Id="BlocklistPublicKey" Name="blocklist-public-key.pem" Source="blocklist-public-key.pem" />
          <ServiceInstall Id="SafeBrowseServiceInstall" Name="Safe Browse Protection" DisplayName="Safe Browse Protection" Description="Local parental-control DNS filtering" Start="auto" Type="ownProcess" ErrorControl="normal" Account="LocalSystem" />
          <ServiceControl Id="SafeBrowseServiceControl" Name="Safe Browse Protection" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="NativeHostComponent" Guid="*">
          <File Id="NativeHostExe" Source="..\artifacts\native-host\SafeBrowse.NativeHost.exe" KeyPath="yes" />
          <File Id="ChromiumManifest" Source="..\artifacts\native-host\com.incorpify.safebrowse.chromium.json" />
          <File Id="FirefoxManifest" Source="..\artifacts\native-host\com.incorpify.safebrowse.firefox.json" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.incorpify.safebrowse" Type="string" Value="[#ChromiumManifest]" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.incorpify.safebrowse" Type="string" Value="[#ChromiumManifest]" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Mozilla\NativeMessagingHosts\com.incorpify.safebrowse" Type="string" Value="[#FirefoxManifest]" />
        </Component>
        <Component Id="EnrollComponent" Guid="*">
          <File Id="EnrollExe" Source="..\artifacts\enroll\SafeBrowse.Enroll.exe" KeyPath="yes" />
        </Component>
        <Component Id="TrayComponent" Guid="*">
          <File Id="TrayExe" Source="..\artifacts\tray\SafeBrowse.Tray.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      Start Menu shortcut to the enrollment dialog. Enrollment is not a one-time
      installer step: a code can expire before it is typed, a parent can move the PC
      to a different child, or a device can be revoked and re-enrolled. Without this
      the only way back is an elevated command line.
    -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SafeBrowseMenuFolder" Name="Safe Browse">
        <Component Id="EnrollShortcut" Guid="*">
          <Shortcut Id="EnrollShortcutEntry"
                    Name="Link this PC to Safe Browse"
                    Description="Enter a setup code from the parent console to link this PC to a child profile"
                    Target="[#EnrollExe]"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveSafeBrowseMenuFolder" Directory="SafeBrowseMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Incorpify\SafeBrowse" Name="MenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="Safe Browse" Level="1">
      <ComponentRef Id="ServiceFiles" />
      <ComponentRef Id="NativeHostComponent" />
      <ComponentRef Id="EnrollComponent" />
      <ComponentRef Id="TrayComponent" />
      <ComponentRef Id="EnrollShortcut" />
    </Feature>

    <!-- ── Wizard UI ──────────────────────────────────────────────────────────── -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!--
      Offer to open the enrollment dialog straight from the finish page, so the
      parent goes from double-clicking the MSI to typing the setup code without
      touching a command line.

      Impersonate="yes" is essential: the MSI's deferred sequence runs as SYSTEM in
      session 0, where a window would be created invisibly and the install would
      appear to hang. Running as the invoking user shows the dialog on their desktop.
      SafeBrowse.Enroll.exe requests elevation in its own manifest, so the parent sees
      one further UAC prompt when it starts.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Link this PC to a child profile now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- FileRef launches the installed executable directly (MSI custom action type 18).
         The alternative, WixShellExec from the Util extension, would add a dependency
         whose custom-action binary identifier differs across WiX versions and could
         only be confirmed by building on Windows. -->
    <CustomAction Id="LaunchEnrollDialog"
                  FileRef="EnrollExe"
                  ExeCommand=""
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <UI>
      <!-- Fresh installs only; a repair or upgrade should not re-prompt an
           already-enrolled PC for a code it does not need. -->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchEnrollDialog"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
